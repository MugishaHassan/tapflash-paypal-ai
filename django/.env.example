# Copy this file to .env (next to manage.py) and change what you need.
# Empty lines use the default. On the server, keep .env in the app folder,
# never inside public_html, and never put it in git.

# ---- Django ----

# Keep false on the server. Set true only on your own computer: it shows error
# details to anyone and lets the app start without a SECRET_KEY.
DEBUG=false
# A long random text. Required when DEBUG=false. Make one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
# Your domain, for example: bot.example.com (comma separated if more than one)
ALLOWED_HOSTS=
# The same domain with https://, for example: https://bot.example.com
CSRF_TRUSTED_ORIGINS=
# HTTPS settings for the server. Turn SECURE_SSL_REDIRECT off if pages loop
# with "too many redirects". HSTS tells browsers to always use https.
SECURE_SSL_REDIRECT=false
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=false
# Also write warnings and errors to this file, for example
# /home/withlqsy/tapflash/logs/tapflash.log (empty: only the Passenger log)
LOG_FILE=
# The admin is at /admin/ unless you choose another path, which is harder to guess
ADMIN_PATH=admin

# sqlite (a file, for your computer) or mysql (cPanel)
DB_ENGINE=sqlite
# For sqlite: the file (default db.sqlite3 next to manage.py). For mysql: the database name.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# Where uploaded restroom photos are kept (default: media next to manage.py)
MEDIA_ROOT=
# Where collectstatic puts the admin's CSS and JavaScript (default: staticfiles)
STATIC_ROOT=
# true = Django shows the uploaded photos itself (the default when DEBUG=true)
SERVE_MEDIA=
# Where downloaded map tiles and routes are kept (default: .cache next to manage.py)
CACHE_DIR=

# ---- The bot ----

BOT_NAME=TapFlash

# Money and phone numbers. COUNTRY_CODE is used to read numbers like 0712 345 678.
CURRENCY=KES
COUNTRY_CODE=254
TIMEZONE=Africa/Nairobi
# The price of a restroom that has no price of its own
DEFAULT_PRICE=100
# Card and PayPal fee, in percent (M-Pesa and Airtel Money have none)
CARD_FEE_PERCENT=1

# true  = invent sample restrooms around whoever shares a location (good for testing anywhere)
# false = use the active restrooms in the admin
DEMO_RESTROOMS_NEAR_USER=true
# With the line above false: real restrooms near the user, and sample ones only
# for users far from every real restroom (good for a public demo).
DEMO_RESTROOMS_FALLBACK=false
MAX_RESULTS=4
MAX_DISTANCE_KM=20

# How long a paid pass lasts once the user should have walked there (it ends
# sooner if the restroom closes first), and how long before an idle chat is
# forgotten (a paid journey stays open until its pass ends)
ACCESS_MINUTES=30
SESSION_TIMEOUT_MINUTES=30

# Pictures (restroom photos, payment icons, access card, route maps).
# Maps download OpenStreetMap tiles; set MAP_IMAGES=false to work offline.
IMAGES=true
MAP_IMAGES=true

# ---- Meta WhatsApp Cloud API ----

# Values from developers.facebook.com > your app > WhatsApp > API Setup.
# Keep them secret: put them only in your real .env, never in git or chat.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any long random password you make up; type the same one into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (lets the bot check messages really come from Meta)
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
# thread = tell Meta "got it" at once, then reply in the background (best on cPanel)
# inline = reply first, then tell Meta (simpler, for testing)
WEBHOOK_PROCESSING=thread
# The browser test chat at / and /api/message (on by default when DEBUG=true).
# Keep it off on the server: anyone could chat and make test payments.
WEB_CHAT=

# ---- WhatsApp Web bridge (the owner's PC) ----

# A long random secret. With it, /api/message accepts requests that carry
# "Authorization: Bearer <BRIDGE_TOKEN>" even when WEB_CHAT is off. Put the
# same value in the PC's .env as REMOTE_BOT_TOKEN. Make one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=

# ---- PayPal (sandbox for the hackathon) ----

# developer.paypal.com > Apps & Credentials > (Sandbox) your app.
# Without these, card and PayPal payments stay simulated like mobile money.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (test money) or live
PAYPAL_ENV=sandbox
# From the app's Webhooks section after adding https://<your domain>/paypal/webhook
# with the events CHECKOUT.ORDER.APPROVED and PAYMENT.CAPTURE.REFUNDED.
PAYPAL_WEBHOOK_ID=
# PayPal does not take KES: totals are charged in this currency at this rate
# (KES per 1 USD).
PAYPAL_CURRENCY=USD
PAYPAL_RATE=129
# This server's address as phones see it, so PayPal can send buyers back
# (https://bot.example.com). Needed for the WhatsApp bridge.
PUBLIC_URL=
# The bot's WhatsApp number with the country code (254712345678), for the
# "Back to WhatsApp" button after paying.
BOT_WHATSAPP_NUMBER=

# ---- AI (Google Gemini, free tier) ----

# aistudio.google.com > Get API key. Without it the bot uses its menus only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Problem reports may refund on their own within this many minutes of paying,
# at most this many times per user per day. Anything else goes to staff.
REFUND_WINDOW_MINUTES=120
MAX_REFUNDS_PER_DAY=1

# Cleaning bonuses: a cleaner (added in the admin) sends a photo after cleaning,
# Gemini checks it, and an approved cleaning is paid at once with PayPal Payouts.
# At most one bonus per cleaner every CLEANING_BONUS_HOURS, and CLEANING_MAX_PER_DAY a day.
CLEANING_BONUS_HOURS=4
CLEANING_MAX_PER_DAY=3
