# Copy this file to .env and change what you need. Every line is optional.

# Which connection to use: whatsapp-web (free, scan a QR code) or console (terminal simulator)
CONNECTOR=whatsapp-web

BOT_NAME=TapFlash

# Money and phone numbers. COUNTRY_CODE is used to read numbers like 0712 345 678.
CURRENCY=KES
COUNTRY_CODE=254
TIMEZONE=Africa/Nairobi
DEFAULT_PRICE=100
CARD_FEE_PERCENT=1

# true  = invent sample restrooms around whoever shares a location (good for testing anywhere)
# false = use the real list in data/restrooms.json
DEMO_RESTROOMS_NEAR_USER=true
MAX_RESULTS=4
MAX_DISTANCE_KM=20

# How long a paid pass lasts once the user should have walked there (it ends
# sooner if the restroom closes first), and how long before an idle chat is
# forgotten (a paid journey stays open until its pass ends)
ACCESS_MINUTES=30
SESSION_TIMEOUT_MINUTES=30

# Pause before each reply (shows "typing…"), in milliseconds
REPLY_DELAY_MS=800

# Pictures (restroom list, payment methods, access card, route maps).
# Maps download OpenStreetMap tiles; set MAP_IMAGES=false to work offline.
IMAGES=true
MAP_IMAGES=true

# Port for the browser tester (npm run web)
WEB_PORT=3000

# ---- Meta WhatsApp Cloud API (for hosting on your domain) ----
# CONNECTOR=cloud-api
# Values from developers.facebook.com > your app > WhatsApp > API Setup.
# Keep them secret: put them only in your real .env, never in git or chat.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any long random password you make up; type the same one into Meta's webhook settings.
WHATSAPP_VERIFY_TOKEN=
# App settings > Basic > App secret (lets the bot check messages really come from Meta)
WHATSAPP_APP_SECRET=
GRAPH_API_VERSION=v23.0
WEBHOOK_PATH=/webhook

# Save chats and paid passes in records/state.json so restarts don't lose them
SAVE_STATE=true

# ---- Bridge: test on real WhatsApp before Meta's API is set up ----
# The bot's WhatsApp is linked on this PC (scan a QR code, npm run bridge), and
# every message is passed to the TapFlash server, which writes the answers.
# Setting REMOTE_BOT_URL turns the bridge on; leave it empty to run the bot here.
# Use https (plain http only works for a server on this PC, like http://localhost:8000).
REMOTE_BOT_URL=
# The server's bridge token (from the server's settings). Keep it secret.
REMOTE_BOT_TOKEN=
# How long to wait for the server's answer, in milliseconds
REMOTE_BOT_TIMEOUT_MS=30000
